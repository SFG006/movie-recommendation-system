    "   \"source\": [\n",
    "    \"import warnings\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Suppress only the divide/nan RuntimeWarnings\\n\",\n",
    "    \"warnings.filterwarnings(\\\"ignore\\\", category=RuntimeWarning) # \\\"RuntimeWarning\\\" - ignore only warnings related to math issues (like divide by zero)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_similar_movies(movie_name, min_shared_ratings=5, min_total_ratings=50): # min_shared_ratings=5 = default: at least 5 users must have rated both movies\\n\",\n",
    "    \"    # min_total_ratings=50 = default: only consider movies rated by at least 50 people\\n\",\n",
    "    \"    target_ratings = ratings_matrix[movie_name]  # get that movie’s column from the user–movie matrix(rating_matrix)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Only consider movies with enough overlapping ratings with the target movie\\n\",\n",
    "    \"    def has_enough_overlap(x):  # \\\"x\\\" represent a column,ratings for another movie\\n\",\n",
    "    \"        common = target_ratings.notna() & x.notna() #  notna() function is used to detect non-missing values in a pandas DataFrame or Series. It returns a boolean mask where True indicates a non-missing value (i.e., not NaN or None), and False indicates a missing value.\\n\",\n",
    "    \"        return common.sum() >= min_shared_ratings\\n\",\n",
    "    \"\\n\",\n",
    "    \"    filtered_matrix = ratings_matrix.loc[:,ratings_matrix.apply(has_enough_overlap)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Compute correlation\\n\",\n",
    "    \"    similar_scores = filtered_matrix.corrwith(target_ratings)\\n\",\n",
    "    \"    # Computes Pearson correlation between each movie and target_ratings.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Drop any NaNs or invalid results\\n\",\n",
    "    \"    corr_df = pd.DataFrame(similar_scores, columns=['correlation'])\\n\",\n",
    "    \"    corr_df.dropna(inplace=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Join with rating counts\\n\",\n",
    "    \"    corr_df = corr_df.join(rating_counts.set_index('title'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Filter by number of total ratings\\n\",\n",
    "    \"    result = corr_df[corr_df['num_ratings'] >= min_total_ratings]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return result.sort_values('correlation', ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Example call:\\n\",\n",
    "    \"get_similar_movies(\\\"Forrest Gump (1994)\\\").head(10)\\n\"\n",
