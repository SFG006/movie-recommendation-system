    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"#### Lowercasing all text in 'tags' column,to normalize it for text processing\",\n",
    "   \"id\": \"bffa94d0c2ca457f\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-21T14:51:22.305214Z\",\n",
    "     \"start_time\": \"2025-05-21T14:51:19.148967Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"moviess['tags'] = moviess['tags'].str.lower()\",\n",
    "   \"id\": \"ecc34b687dcd47b6\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 40\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"### Vectorization\",\n",
    "   \"id\": \"5bd5186c2c98dc88\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-21T14:52:27.098325Z\",\n",
    "     \"start_time\": \"2025-05-21T14:51:22.417228Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.feature_extraction.text import CountVectorizer\\n\",\n",
    "    \"\\n\",\n",
    "    \"cv = CountVectorizer(max_features=5000 ,stop_words='english')\\n\",\n",
    "    \"vectors = cv.fit_transform(moviess['tags'])\"\n",
    "   ],\n",
    "   \"id\": \"770aaccd3cd28b38\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 41\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"### Calculate similarity between movies\",\n",
    "   \"id\": \"ea53f67ccff35f69\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-21T14:52:27.697457Z\",\n",
    "     \"start_time\": \"2025-05-21T14:52:27.235070Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.metrics.pairwise import cosine_similarity\\n\",\n",
    "    \"\\n\",\n",
    "    \"def recommend(movie_title):\\n\",\n",
    "    \"    # Get index of the movie\\n\",\n",
    "    \"    idx = moviess[moviess['title'].str.lower() == movie_title.lower()].index\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if len(idx) == 0:\\n\",\n",
    "    \"        print(\\\"Movie not found.\\\")\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    idx = idx[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Compute cosine similarity between this movie and all others\\n\",\n",
    "    \"    distances = cosine_similarity(vectors[idx], vectors)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Get top 5 similar movies (excluding itself)\\n\",\n",
    "    \"    movie_list = sorted(list(enumerate(distances[0])), key=lambda x: x[1], reverse=True)[1:6]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Top 5 similar movies to:\\\", movie_title)\\n\",\n",
    "    \"    for i in movie_list:\\n\",\n",
    "    \"        print(moviess.iloc[i[0]].title)\\n\"\n",
    "   ],\n",
    "   \"id\": \"b11569d1e907b5d7\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 42\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-21T14:52:49.348353Z\",\n",
    "     \"start_time\": \"2025-05-21T14:52:43.247954Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"recommend(\\\"The Dark Knight\\\")\",\n",
    "   \"id\": \"e75b6de9f994cda\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Top 5 similar movies to: The Dark Knight\\n\",\n",
    "      \"Batman\\n\",\n",
    "      \"Batman Begins\\n\",\n",
    "      \"Batman: Mask of the Phantasm\\n\",\n",
    "      \"The Dark Knight Rises\\n\",\n",
    "      \"Criminal\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 45\n",
