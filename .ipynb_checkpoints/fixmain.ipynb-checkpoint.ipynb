    "   \"source\": [\n",
    "    \"- enumerate(distances[0]) → creates index-value pairs from distances[0]\\n\",\n",
    "    \"- sorted(..., key=lambda x: x[1], reverse=True) → sorts these pairs by the similarity score (not index) in descending order.\\n\",\n",
