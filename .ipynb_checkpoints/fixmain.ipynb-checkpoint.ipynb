    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"Here we caculating similarity\\n\",\n",
    "    \"- Calculates cosine similarity between \\\"given movie\\\" and all movies\\n\",\n",
    "    \"-  Cosine Similarity Formula:\\n\",\n",
    "    \"   Cosine Similarity Formula:\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$ \\\\text{similarity}(A, B) = \\\\frac{A \\\\cdot B}{||A|| \\\\cdot ||B||} $$\\n\",\n",
    "    \"\\n\",\n",
    "    \"Measures angle between two vectors.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Value between 0 and 1.\\n\",\n",
    "    \"\\n\",\n",
    "    \"1 → exactly similar\\n\",\n",
    "    \"\\n\",\n",
    "    \"0 → completely different\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
    "   \"id\": \"6893f9a2b850bbe5\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-05-21T16:47:43.521710Z\",\n",
    "     \"start_time\": \"2025-05-21T16:47:41.537142Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"distances = cosine_similarity(vectors[idx], vectors)\\n\",\n",
