<+><!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>\uD83C\uDFAC ILLUSTRIOUS FILMS </title>\r\n    <link rel=\"stylesheet\" href=\"{{ url_for('static', filename='style.css') }}\">\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap\" rel=\"stylesheet\">\r\n</head>\r\n\r\n<body>\r\n    <h1 class=\"logo-title\"> ILLUSTRIOUS FILMS </h1>\r\n    <h2 class=\"tagline\" style=\"color: white;\">Curated Cinema Picks for True Film Lovers</h2>\r\n    <form method=\"POST\">\r\n        <input type=\"text\" name=\"movie\" placeholder=\"Enter your favorite movie...\" required>\r\n        <input type=\"submit\" value=\"Recommend\">\r\n    </form>\r\n\r\n    {% if recommended %}\r\n        <h3>Top 5 Recommendations</h3>\r\n        <div class=\"recommendation-grid\">\r\n            {% for rec in recommended %}\r\n            <div class=\"movie-card\">\r\n                {% if rec.poster and rec.imdb %}\r\n                    <a href=\"{{ rec.imdb }}\" target=\"_blank\">\r\n                        <img src=\"{{ rec.poster }}\" alt=\"{{ rec.title }}\">\r\n                    </a>\r\n                {% else %}\r\n                    <img src=\"{{ rec.poster }}\" alt=\"{{ rec.title }}\">\r\n                {% endif %}\r\n                <p>{{ rec.title }}</p>\r\n            </div>\r\n            {% endfor %}\r\n        </div>\r\n    {% endif %}\r\n\r\n    <footer>\r\n        Built with ❤\uFE0F for film lovers |Follow us on\r\n        <div>\r\n        <a href=\"https://www.instagram.com/illustrious_films/\" target=\"_blank\">\r\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/a/a5/Instagram_icon.png\" alt=\"Instagram\" style=\"width:32px;\">\r\n        </a>\r\n        </div>\r\n    </footer>\r\n</body>\r\n</html>\r\n
